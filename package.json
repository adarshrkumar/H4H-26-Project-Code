{
    "name": "audio-to-color",
    "version": "1.0.0",
    "description": "Real-time audio analysis and mood-driven color visualization",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:api": "tsx server/index.ts",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint:scss": "stylelint \"src/**/*.scss\"",
        "stylelint:fix": "npx stylelint \"src/**/*.scss\" --fix",
        "spatial:run": "webspatial-builder run --manifest-url http://localhost:5173/manifest.webmanifest",
        "spatial:build": "webspatial-builder build --manifest-url http://localhost:5173/manifest.webmanifest"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^2.0.67",
        "@ai-sdk/gateway": "^1.0.0",
        "@elevenlabs/elevenlabs-js": "^2.37.0",
        "@neondatabase/serverless": "^0.10.4",
        "@webspatial/core-sdk": "^1.2.0",
        "@webspatial/react-sdk": "^1.2.0",
        "ai": "^5.0.0",
        "audiomotion-analyzer": "^4.5.4",
        "better-auth": "^1.5.0",
        "cors": "^2.8.5",
        "dotenv": "^17.3.1",
        "drizzle-orm": "^0.44.7",
        "express": "^4.21.0",
        "marked": "^14.1.3",
        "nanoid": "^5.0.9",
        "open-props": "^1.7.17",
        "react": "^19.2.4",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.2.0",
        "sass": "^1.82.0",
        "uploadthing": "^7.7.4",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "@webspatial/builder": "^1.2.0",
        "@webspatial/platform-visionos": "^1.2.0",
        "drizzle-kit": "^0.31.9",
        "stylelint": "^17.4.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vite": "^6.0.0",
        "vite-plugin-pwa": "^0.21.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
