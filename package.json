{
    "name": "audio-to-color",
    "version": "1.0.0",
    "description": "Real-time audio analysis and mood-driven color visualization",
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint && npm run lint:scss",
        "lint:scss": "stylelint \"src/**/*.scss\"",
        "ts": "node --experimental-strip-types",
        "test:chrome": "npx playwright test --headed --browser=chromium",
        "test:firefox": "npx playwright test --headed --browser=firefox",
        "test:safari": "npx playwright test --headed --browser=webkit",
        "test": "npm run test:chrome && npm run test:firefox && npm run test:safari",
        "spatial:dev": "SPATIAL_BUILD=1 next build && webspatial-builder run",
        "spatial:build": "SPATIAL_BUILD=1 next build && webspatial-builder build",
        "stylelint:fix": "npx stylelint \"src/**/*.scss\" --fix"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^2.0.67",
        "@ai-sdk/gateway": "^1.0.0",
        "@astrojs/check": "^0.9.6",
        "@astrojs/vercel": "^9.0.2",
        "@elevenlabs/elevenlabs-js": "^2.37.0",
        "@huggingface/transformers": "^3.8.1",
        "@neondatabase/serverless": "^0.10.4",
        "@webspatial/core-sdk": "^1.2.0",
        "@webspatial/react-sdk": "^1.2.0",
        "ai": "^5.0.0",
        "astro": "^5.16.6",
        "audiomotion-analyzer": "^4.5.4",
        "better-auth": "^1.5.0",
        "cheerio": "^1.0.0",
        "dotenv": "^17.3.1",
        "drizzle-orm": "^0.44.7",
        "marked": "^14.1.3",
        "nanoid": "^5.0.9",
        "next": "^15.1.0",
        "open-props": "^1.7.17",
        "prettier": "^3.8.1",
        "react": "^19.2.4",
        "react-dom": "^19.0.0",
        "sass": "^1.82.0",
        "turndown": "^7.2.0",
        "typescript": "^5.7.2",
        "uploadthing": "^7.7.4",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/turndown": "^5.0.5",
        "@webspatial/builder": "^1.2.0",
        "@webspatial/next-plugin": "^0.1.10",
        "@webspatial/platform-visionos": "^1.2.0",
        "drizzle-kit": "^0.31.9",
        "eslint": "^9.0.0",
        "eslint-config-next": "^15.1.0",
        "stylelint": "^17.4.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "vercel": "^39.2.0",
        "vite-plugin-pwa": "^0.21.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
