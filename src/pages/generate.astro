---
import Layout from '@/layouts/Layout.astro';
import '@/styles/pages/generate.scss';
import GenerateScript from '../scripts/GenerateScript.astro';
---

<Layout pageTitle="Generate Music">
    <div class="generate-page">
        <h1>Generate Music</h1>
        <p class="subtitle">Describe your song and ElevenLabs will compose it section by section.</p>

        <form id="generate-form" class="generate-form">
            <div class="field">
                <label for="prompt">Prompt</label>
                <textarea
                    id="prompt"
                    name="prompt"
                    rows="3"
                    placeholder="e.g. An upbeat electronic track with heavy bass and energetic drops"
                    required
                ></textarea>
            </div>

            <div class="field field--inline">
                <label for="duration">Duration (seconds)</label>
                <input
                    type="number"
                    id="duration"
                    name="duration"
                    min="3"
                    max="600"
                    placeholder="Auto"
                />
                <span class="hint">Leave blank to let ElevenLabs decide</span>
            </div>

            <button type="submit" id="generate-btn" class="btn btn--primary">
                Generate
            </button>
        </form>

        <!-- Error banner -->
        <div id="error-banner" class="error-banner" hidden>
            <p id="error-message" class="error-banner__message"></p>
            <div id="suggestion-box" class="suggestion-box" hidden>
                <p class="suggestion-box__label">Suggested alternative:</p>
                <p id="suggestion-text" class="suggestion-box__text"></p>
                <button id="use-suggestion-btn" class="btn btn--secondary btn--small">
                    Use this suggestion
                </button>
            </div>
        </div>

        <!-- Loading state -->
        <div id="loading" class="loading" hidden>
            <div class="loading__spinner"></div>
            <p id="loading-message" class="loading__message">Creating composition plan…</p>
        </div>

        <!-- Sections grid -->
        <div id="sections-container" class="sections-container" hidden>
            <h2 class="sections-title">Sections</h2>
            <div id="sections-grid" class="sections-grid"></div>
        </div>
    </div>

    <GenerateScript />
</Layout>
