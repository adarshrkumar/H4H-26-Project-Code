---
import Layout from '@/layouts/Layout.astro';
import ViewPageContent from '@/components/ViewPageContent.astro';
import { getRecording } from '@/db/helpers';
import { getFileUrl } from '@/lib/uploadthing';

const { id } = Astro.params;

// Fetch the music record from the database
let music = null;
let audioUrl = '';
let errorMessage = '';

try {
    if (!id) {
        throw new Error('No music ID provided');
    }

    music = await getRecording(id);

    if (!music) {
        errorMessage = 'Music not found';
    } else {
        // Get the file URL - either from stored data or reconstruct from UploadThing
        const file = music.file as { key?: string } | undefined;
        const fileKey = file?.key || id;
        audioUrl = getFileUrl(fileKey);
    }
} catch (err: unknown) {
    errorMessage = err instanceof Error ? err.message : 'Failed to load music';
}
---

<Layout pageTitle={music?.title ? ['Audio to Color', music.title] : 'Audio to Color'}>
    <ViewPageContent {music} {audioUrl} {errorMessage} />
</Layout>
