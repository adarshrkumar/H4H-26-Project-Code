<script>
    // --- Elements ---
    const form = document.getElementById('generate-form') as HTMLFormElement;
    const promptInput = document.getElementById('prompt') as HTMLTextAreaElement;
    const durationInput = document.getElementById('duration') as HTMLInputElement;
    const generateBtn = document.getElementById('generate-btn') as HTMLButtonElement;
    const errorBanner = document.getElementById('error-banner') as HTMLDivElement;
    const errorMessage = document.getElementById('error-message') as HTMLParagraphElement;
    const suggestionBox = document.getElementById('suggestion-box') as HTMLDivElement;
    const suggestionText = document.getElementById('suggestion-text') as HTMLParagraphElement;
    const useSuggestionBtn = document.getElementById('use-suggestion-btn') as HTMLButtonElement;
    const loading = document.getElementById('loading') as HTMLDivElement;
    const loadingMessage = document.getElementById('loading-message') as HTMLParagraphElement;
    const sectionsContainer = document.getElementById('sections-container') as HTMLDivElement;
    const sectionsGrid = document.getElementById('sections-grid') as HTMLDivElement;

    // --- Types matching the API route response ---
    interface SectionResponse {
        sectionName: string;
        durationMs: number;
        filename: string;
        genres: string[];
        title: string;
        audioBase64: string;
    }

    interface GenerateResponse {
        sections: SectionResponse[];
    }

    interface ErrorResponse {
        error: string;
        code: 'bad_prompt' | 'bad_composition_plan' | 'unknown';
        suggestion?: string;
        sectionName?: string;
    }

    // --- Helpers ---
    function setLoading(on: boolean, message = 'Creating composition plan…') {
        loading.hidden = !on;
        loadingMessage.textContent = message;
        generateBtn.disabled = on;
        generateBtn.textContent = on ? 'Generating…' : 'Generate';
    }

    function showError(message: string, suggestion?: string) {
        errorBanner.hidden = false;
        errorMessage.textContent = message;
        if (suggestion) {
            suggestionBox.hidden = false;
            suggestionText.textContent = suggestion;
        } else {
            suggestionBox.hidden = true;
        }
    }

    function clearError() {
        errorBanner.hidden = true;
        suggestionBox.hidden = true;
    }

    function base64ToObjectUrl(base64: string, mimeType = 'audio/mpeg'): string {
        const binary = atob(base64);
        const bytes = new Uint8Array(binary.length);
        for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
        const blob = new Blob([bytes], { type: mimeType });
        return URL.createObjectURL(blob);
    }

    function formatDuration(ms: number): string {
        const secs = Math.round(ms / 1000);
        return secs >= 60 ? `${Math.floor(secs / 60)}m ${secs % 60}s` : `${secs}s`;
    }

    function renderSections(sections: SectionResponse[]) {
        sectionsGrid.innerHTML = '';

        sections.forEach((section) => {
            const objectUrl = base64ToObjectUrl(section.audioBase64);

            const card = document.createElement('div');
            card.className = 'section-card';
            card.innerHTML = `
                <div class="section-card__header">
                    <span class="section-card__name">${section.sectionName}</span>
                    <span class="section-card__duration">${formatDuration(section.durationMs)}</span>
                </div>
                ${section.title ? `<p class="section-card__title">${section.title}</p>` : ''}
                ${section.genres.length ? `
                    <div class="section-card__genres">
                        ${section.genres.map(g => `<span class="genre-tag">${g}</span>`).join('')}
                    </div>` : ''}
                <audio class="section-card__audio" controls src="${objectUrl}"></audio>
                <a class="section-card__download btn secondary small"
                   href="${objectUrl}"
                   download="${section.filename}">
                    Download
                </a>
            `;
            sectionsGrid.appendChild(card);
        });

        sectionsContainer.hidden = false;
    }

    // --- Use suggestion button ---
    useSuggestionBtn.addEventListener('click', () => {
        promptInput.value = suggestionText.textContent ?? '';
        clearError();
        sectionsContainer.hidden = true;
    });

    // --- Form submit ---
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearError();
        sectionsContainer.hidden = true;
        sectionsGrid.innerHTML = '';

        const prompt = promptInput.value.trim();
        const durationSecs = durationInput.value ? Number(durationInput.value) : null;
        const musicLengthMs = durationSecs ? durationSecs * 1000 : undefined;

        setLoading(true, 'Creating composition plan…');

        try {
            const res = await fetch('/api/generate-music', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ prompt, musicLengthMs }),
            });

            setLoading(true, 'Composing sections…');

            if (!res.ok) {
                const err: ErrorResponse = await res.json();
                if (err.code === 'bad_prompt') {
                    showError(
                        'Your prompt contains a banned artist name or copyrighted lyrics.',
                        err.suggestion
                    );
                } else if (err.code === 'bad_composition_plan') {
                    showError(
                        `Section "${err.sectionName}" was flagged for copyrighted content.`,
                        err.suggestion
                    );
                } else {
                    showError(err.error ?? 'Something went wrong. Please try again.');
                }
                return;
            }

            const data: GenerateResponse = await res.json();
            renderSections(data.sections);
        } catch {
            showError('Network error — could not reach the server.');
        } finally {
            setLoading(false);
        }
    });
</script>
